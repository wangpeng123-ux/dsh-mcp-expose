{
  "name": "dsh-mcp-expose",
  "version": "1.2.0",
  "type": "module",
  "description": "Expose DeepSeek Harness as an MCP server — the whole runtime, or just one session you pick in the UI — for Codex, WorkBuddy, Claude Code, or any MCP client.",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "codex",
    "claude-code",
    "workbuddy",
    "agent"
  ],
  "author": "wangpeng123-ux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangpeng123-ux/dsh-mcp-expose.git"
  },
  "homepage": "https://github.com/wangpeng123-ux/dsh-mcp-expose#readme",
  "bugs": {
    "url": "https://github.com/wangpeng123-ux/dsh-mcp-expose/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
